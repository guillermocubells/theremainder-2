# Copia este fichero a .env con los valores de TU proyecto de Supabase
# (Project Settings -> API Keys). La clave publicable es publica por diseno:
# viaja en el bundle del cliente y solo es segura si RLS esta activo.
VITE_SUPABASE_PROJECT_ID=<tu-project-ref>
VITE_SUPABASE_URL=https://<tu-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<tu-clave-publicable>

# ── Proveedor de IA (secretos de las edge functions) ─────────────────────────
# Lo usan `recommend-plants` (recomendador del catalogo) y
# `ai-plant-autocomplete` (alta de plantas del admin). Sin AI_API_KEY las dos
# responden 503 AI_NOT_CONFIGURED y la tienda funciona sin recomendador.
# Vale cualquier proveedor compatible con la API de OpenAI.
AI_API_KEY=<tu-clave>
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash

# ── Pagos (secretos de las edge functions) ──────────────────────────────────
# Sin estas, `PAGOS_ACTIVOS` en src/config/store.ts debe quedarse en false: el
# ultimo paso del checkout recoge el pedido como solicitud en vez de cobrar.
# STRIPE_WEBHOOK_SECRET hay que REGENERARLO al cambiar de proyecto: es por
# endpoint, y un proyecto nuevo da una URL nueva.
STRIPE_SECRET_KEY=<sk_...>              # auction-deposit, create-checkout, create-connect-account, settle-auction, stripe-webhook
STRIPE_WEBHOOK_SECRET=<whsec_...>       # stripe-webhook
VITE_STRIPE_PUBLISHABLE_KEY=<pk_...>    # create-checkout. Tambien como secreto de edge function, aunque lleve prefijo VITE_

# ── Correo (secretos de las edge functions) ─────────────────────────────────
# Sin RESEND_API_KEY los pedidos SI se guardan en `quote_requests`, pero no
# llega aviso a nadie: hay que mirar la tabla a mano.
RESEND_API_KEY=<re_...>                 # notify-restock, send-auction-notification, send-notification-email, send-quote-request
RESTOCK_WEBHOOK_SECRET=<cadena-larga>   # notify-restock: autentica el disparo del aviso de reposicion
SITE_URL=https://theremainder.pl        # notify-restock: enlaces de los correos
